# ─── Base de datos EXTERNA (solo lectura) ───────────────────────────────────
DB_EXTERNA_HOST=tu_host_aqui
DB_EXTERNA_PORT=3306
DB_EXTERNA_USER=tu_usuario_aqui
DB_EXTERNA_PASSWORD=tu_password_aqui
DB_EXTERNA_NAME=nombre_bd_externa

# ─── Base de datos PROPIA (lectura/escritura) ────────────────────────────────
# En desarrollo, siempre `testing` (el entorno de prueba del área). La base
# `preliquidacion` es producción: la app se niega a arrancar contra ella salvo
# que este archivo tenga PERMITIR_BASE_PRODUCCION=1, y eso va sólo en el VPS.
DB_PROPIA_HOST=localhost
DB_PROPIA_PORT=3306
DB_PROPIA_USER=root
DB_PROPIA_PASSWORD=tu_password_aqui
DB_PROPIA_NAME=testing
# PERMITIR_BASE_PRODUCCION=1   # sólo en el .env del VPS

# ─── Base de datos SUELDOS (solo lectura, maestro de empleados) ──────────────
# OBLIGATORIA: la aplicación no arranca sin estas variables.
DB_SUELDOS_HOST=tu_host_aqui
DB_SUELDOS_PORT=3306
DB_SUELDOS_USER=tu_usuario_aqui
DB_SUELDOS_PASSWORD=tu_password_aqui
DB_SUELDOS_NAME=nombre_bd_sueldos

# ─── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-segura-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── CORS (frontend local en desarrollo) ─────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Asistente de ayuda de uso (OpenAI) ──────────────────────────────────────
# Dejar OPENAI_API_KEY vacío deshabilita el asistente (el resto de la app anda igual).
OPENAI_API_KEY=
ASISTENTE_MODELO=gpt-4o-mini

# ─── Base de DESARROLLO (destino de scripts/refrescar_testing.py) ────────────
# Solo en la máquina de quien refresca `testing` desde producción. Host y puerto
# vacíos = los de DB_PROPIA_*. El script copia DESDE DB_PROPIA_* HACIA DB_DEV_*:
# con DB_PROPIA_* apuntando a `testing`, se corre pasándole producción como
# variables de entorno, o se niega (origen y destino serían la misma base).
DB_DEV_HOST=
DB_DEV_PORT=3306
DB_DEV_USER=
DB_DEV_PASSWORD=
DB_DEV_NAME=testing
